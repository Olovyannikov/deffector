{
  "name": "@deffector/agent",
  "version": "0.1.2",
  "description": "DevTools for effector: every user action as one transaction, time travel, state injection, effect overrides and replayable traces. The agent that runs in your app.",
  "keywords": [
    "effector",
    "devtools",
    "debugger",
    "time-travel",
    "state-management",
    "react",
    "vue",
    "solid",
    "nextjs",
    "ssr",
    "react-native"
  ],
  "homepage": "https://mxmvshnvsk.github.io/deffector/",
  "bugs": {
    "url": "https://github.com/mxmvshnvsk/deffector/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mxmvshnvsk/deffector.git",
    "directory": "packages/agent"
  },
  "license": "MIT",
  "author": "Maxim Vishnevsky <mxmvshnvsk@gmail.com> (https://github.com/mxmvshnvsk)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "production": "./dist/noop.js",
      "@deffector/source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "production": "./dist/react-noop.js",
      "@deffector/source": "./src/adapters/react.tsx",
      "default": "./dist/react.js"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "production": "./dist/vue-noop.js",
      "@deffector/source": "./src/adapters/vue.ts",
      "default": "./dist/vue.js"
    },
    "./solid": {
      "types": "./dist/solid.d.ts",
      "production": "./src/adapters/solid-noop.tsx",
      "solid": "./src/adapters/solid.tsx",
      "default": "./src/adapters/solid.tsx"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "production": "./dist/node-noop.js",
      "@deffector/source": "./src/node.ts",
      "default": "./dist/node.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src/adapters/solid.tsx",
    "src/adapters/solid-noop.tsx"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "effector": ">=22.6.0",
    "effector-react": ">=23",
    "effector-solid": ">=0.23",
    "effector-vue": ">=23",
    "react": ">=18",
    "solid-js": ">=1.8",
    "vue": ">=3.3"
  },
  "peerDependenciesMeta": {
    "effector-react": {
      "optional": true
    },
    "effector-solid": {
      "optional": true
    },
    "effector-vue": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deffector/protocol": "0.1.0",
    "@types/react": "^19.3.0",
    "effector": "23.4.4",
    "effector-react": "^23.3.0",
    "effector-solid": "^0.23.0",
    "effector-vue": "^23.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "solid-js": "^1.9.17",
    "vue": "^3.5.43"
  },
  "publishConfig": {
    "access": "public"
  }
}
